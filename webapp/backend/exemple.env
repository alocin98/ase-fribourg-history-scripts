# Database configuration
DATABASE_URL=postgresql+asyncpg://user:pswd@db:5432/db
POSTGRES_USER=user
POSTGRES_PASSWORD=pswd
POSTGRES_DB=db

# user of the API
DEFAULT_USER=user
DEFAULT_PASSWORD=password

# API configuration
SECRET_KEY=your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=11520
API_STR=/api
API_TITLE=title
API_DESCRIPTION=description
API_VERSION=version

# Storage configuration
STORAGE_ROOT=/data/documents
MAX_UPLOAD_SIZE=524288000

# Ports configuration
API_PORT=8000
DB_PORT=5432
ADMINER_PORT=8080