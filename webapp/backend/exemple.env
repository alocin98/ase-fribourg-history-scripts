# Database configuration
DATABASE_URL=postgresql+asyncpg://user:pswd@db:5432/db
POSTGRES_USER=user
POSTGRES_PASSWORD=pswd
POSTGRES_DB=db
DB_ECHO=true

# API configuration
SESSION_EXPIRE_MINUTES=10080
SESSION_COOKIE_NAME=ase_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=ase_csrf
CSRF_HEADER_NAME=X-CSRF-Token
API_STR=/api
API_TITLE="Fribourg History Scripts API"
API_DESCRIPTION="Backend for uploading and browsing scanned historical documents (ASE group 6, Autumn 2026)."
API_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000"]

# Storage configuration
STORAGE_ROOT=/data/documents
MAX_UPLOAD_SIZE=524288000

# Ports configuration
API_PORT=8000
DB_PORT=5432
ADMINER_PORT=8080

# Model Backend connection
MODEL_BACKEND_URL=http://localhost:8001