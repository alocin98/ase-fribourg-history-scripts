# Production variables for Coolify (manuscript-ai / production).
# Names only — real values are set in Coolify, never committed.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<postgres-uuid>:5432/<db>
DB_ECHO=false

SESSION_EXPIRE_MINUTES=10080
SESSION_COOKIE_NAME=ase_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=ase_csrf
CSRF_HEADER_NAME=X-CSRF-Token
API_STR=/api
API_TITLE="Manuscript AI API"
API_DESCRIPTION="Backend for uploading and browsing scanned historical documents (ASE group 6, Autumn 2026)."
API_VERSION=0.1.0
CORS_ORIGINS=["https://manuscript-ai.coffee-journal.com"]

# Persistent volume mounted at this path
STORAGE_ROOT=/data/documents
MAX_UPLOAD_SIZE=524288000

# Model Backend connection
MODEL_BACKEND_URL=http://localhost:8001
