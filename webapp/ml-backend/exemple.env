# Host port of the OCR API (the backend reaches it via MODEL_BACKEND_URL)
ML_PORT=8001

# Inference device: cpu or cuda
DEVICE=cpu

# oneDNN (1 = on); off by default, it makes BLLA run out of memory in a 4 GB Docker VM
MKLDNN=0

# Pages wider than this ratio are padded with white at the bottom before BLLA
MAX_ASPECT=1.4
