# API configuration
API_STR=/api
API_TITLE="Manuscript AI ML API"
API_DESCRIPTION="Text segmentation (BLLA) and recognition (CATMuS Medieval) for the main backend."
API_VERSION=0.1.0

# Models (empty SEGMENTATION_MODEL = kraken's bundled BLLA model)
SEGMENTATION_MODEL=
RECOGNITION_MODEL=/models/catmus-medieval.mlmodel

# Upload limit in bytes
MAX_UPLOAD_SIZE=52428800

# Ports configuration
API_PORT=8001
